# Supabase — copy this file to `.env` and fill in real values before building.
# Only the public anon key belongs here. NEVER put the service-role key in
# .env: it is bundled into the app binary.
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

